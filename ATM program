#include <iostream>
#include <iomanip> 
using namespace std;

int main() 
{
    // Assume initial account balance and daily withdrawal limit
    double accountBalance = 1500.0;
    double dailyLimit = 500.0;

    // Variables for withdrawal amount and transaction status
    double withdrawalAmount;
    bool transactionSuccessful = false;

    // Input withdrawal amount from user
    cout << "Enter withdrawal amount: $";
    cin >> withdrawalAmount;

    // Verify if withdrawal amount exceeds daily limit
    if (withdrawalAmount > dailyLimit) {
        cout << "Withdrawal amount exceeds daily limit of $" << dailyLimit << endl;
    } else {
        // Verify if withdrawal amount exceeds account balance
        if (withdrawalAmount > accountBalance) {
            cout << "Insufficient funds. Current balance is $" << accountBalance << endl;
        } else {
            // Process withdrawal
            accountBalance -= withdrawalAmount;
            cout << "Withdrawal of $" << withdrawalAmount << " successful." << endl;
            cout << "Remaining balance: $" << accountBalance << endl;
            transactionSuccessful = true;
        }
    }

    // Output transaction status
    if (transactionSuccessful) {
        cout << "Transaction completed successfully." << endl;
    } else {
        cout << "Transaction failed." << endl;
    }

    return 0;
}






#include <iostream>
#include <iomanip> 
using namespace std; 

int main() 
{
    int age;
    char movieType;
    double ticketPrice;

    // Input customer's age
    cout << "Enter customer's age: ";
    cin >> age;

    // Input movie type (r for regular, 3 for 3D)
    cout << "Enter movie type (r for regular, 3 for 3D): ";
    cin >> movieType;

    // Determine ticket price based on age and movie type
    if (age >= 18)
     {
        // Adult ticket prices (based on SD)
        if (movieType == 'r') {
            ticketPrice = 12.50; 
        } else if (movieType == '3') {
            ticketPrice = 15.50; 
        } else {
            cout << "Invalid movie type entered." << endl;
            return 1; // Exit program with error code
        }
    } 
    
    else if (age >= 12 && age <= 17) 
    {
        // Teen ticket prices (ages 12-17)
        if (movieType == 'r') {
            ticketPrice = 10.00; 
        } else if (movieType == '3') {
            ticketPrice = 13.00; 
        } else {
            cout << "Invalid movie type entered." << endl;
            return 1; // Exit program with error code
        }
    } 
    
    else if (age >= 5 && age <= 11) 
    {
        // Child ticket prices (ages 5-11)
        if (movieType == 'r') {
            ticketPrice = 8.00; 
        } else if (movieType == '3') {
            ticketPrice = 11.00; 
        } else {
            cout << "Invalid movie type entered." << endl;
            return 1; // Exit program with error code
        }
    } 
    
    else 
    {
        // Invalid age for ticket pricing
        cout << "Invalid age entered." << endl;
        return 1; // Exit program with error code
    }

    // Output the ticket price
    cout << fixed << setprecision(2); // Set output to 2 decimal places
    cout << "Ticket price: $" << ticketPrice << endl;

    return 0;
}